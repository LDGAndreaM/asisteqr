// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TEACHER
  STUDENT
}

enum AttendanceStatus {
  PRESENTE
  RETARDO
  FALTA
}

// cómo se capturó un registro de asistencia
enum AttendanceSource {
  QR
  MANUAL
}

// NUMERIC: calificación numérica sobre maxScore (100, 10, …)
// OPTIONS: lista de opciones definida por el maestro (ej. 1 / R / 0)
enum GradeScaleType {
  NUMERIC
  OPTIONS
}

enum LocationStatus {
  DENTRO
  FUERA
  NA
}

enum JustificationStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model User {
  id             String   @id @default(cuid())
  role           Role
  name           String
  email          String   @unique
  passwordHash   String?  // null si la cuenta solo usa "Continuar con Google"
  institutionId  String?  @unique // matrícula, solo alumnos
  createdAt      DateTime @default(now())

  subjectsTaught   Subject[]        @relation("TeacherSubjects")
  enrollments      Enrollment[]
  attendanceRecords AttendanceRecord[]
  justifications   Justification[]  @relation("StudentJustifications")
  reviewedJustifications Justification[] @relation("ReviewerJustifications")
  claimedInvitations Invitation[]   @relation("ClaimedInvitations")
  grades           Grade[]
  rubricTemplates  RubricTemplate[]
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String
  room        String
  scheduleText String
  icon        String   @default("📚")
  tint        String   @default("#ede9ff")
  // schedule: which weekdays (0=Mon..4=Fri) this subject meets, for report matrix
  weekdays    Int[]    @default([])
  // radio de validación del geocerco; el centro se captura al generar el QR (ver QrToken),
  // así se ajusta solo si la clase cambia de salón
  radiusM     Int      @default(120)
  active      Boolean  @default(true)
  // código corto (6 caracteres, letras y números) con el que los alumnos se unen a la materia
  joinCode    String   @unique
  joinEnabled Boolean  @default(true)
  createdAt   DateTime @default(now())

  teacherId   String
  teacher     User     @relation("TeacherSubjects", fields: [teacherId], references: [id])

  enrollments Enrollment[]
  invitations Invitation[]
  qrTokens    QrToken[]
  attendanceRecords AttendanceRecord[]
  justifications Justification[]
  assignments Assignment[]
  gradingScales GradingScale[]

  @@unique([teacherId, code])
}

model Enrollment {
  id        String  @id @default(cuid())
  subjectId String
  studentId String
  active    Boolean @default(true)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  student   User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([subjectId, studentId])
}

model Invitation {
  id                 String    @id @default(cuid())
  subjectId          String
  subject            Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  email              String
  createdAt          DateTime  @default(now())
  claimedAt          DateTime?
  claimedByStudentId String?
  claimedBy          User?     @relation("ClaimedInvitations", fields: [claimedByStudentId], references: [id])

  @@unique([subjectId, email])
}

model QrToken {
  id        String   @id @default(cuid())
  token     String   @unique
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  issuedAt  DateTime @default(now())
  expiresAt DateTime
  usedBy    String[] @default([]) // studentIds who already scanned this token (session-level de-dup)
  // ubicación del maestro al generar el código; centro del geocerco para esta sesión de clase
  latitude  Float?
  longitude Float?

  @@index([subjectId])
}

model AttendanceRecord {
  id            String           @id @default(cuid())
  subjectId     String
  subject       Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentId     String
  student       User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scannedAt     DateTime         @default(now())
  classDate     DateTime         // day (midnight) this record counts towards
  status        AttendanceStatus @default(PRESENTE)
  source        AttendanceSource @default(QR)
  locationStatus LocationStatus  @default(NA)
  latitude      Float?
  longitude     Float?
  distanceM     Float?

  @@unique([subjectId, studentId, classDate])
  @@index([subjectId, classDate])
}

model Justification {
  id           String   @id @default(cuid())
  studentId    String
  student      User     @relation("StudentJustifications", fields: [studentId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  absenceDate  DateTime // día que se justificará
  reason       String
  fileName     String
  filePath     String
  status       JustificationStatus @default(PENDIENTE)
  createdAt    DateTime @default(now())
  reviewedAt   DateTime?
  reviewerId   String?
  reviewer     User?    @relation("ReviewerJustifications", fields: [reviewerId], references: [id])
}

// Escala de calificación personalizada que el maestro guarda en una materia para reutilizarla
// al crear asignaciones (las escalas predefinidas viven en src/lib/grading.ts).
model GradingScale {
  id        String         @id @default(cuid())
  subjectId String
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  type      GradeScaleType
  maxScore  Float?         // solo NUMERIC
  options   Json?          // solo OPTIONS: [{ code, label, value }]
  createdAt DateTime       @default(now())

  @@index([subjectId])
}

model Assignment {
  id          String         @id @default(cuid())
  subjectId   String
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name        String
  description String         @default("")
  dueDate     DateTime?
  // ponderación de la asignación en el promedio de la materia
  weight      Float          @default(1)
  // copia de la escala al crear la asignación, para que editar una escala no altere calificaciones
  scaleName   String
  scaleType   GradeScaleType
  maxScore    Float?
  options     Json?
  // rúbrica: [{ id, title, description, points }]
  rubric      Json           @default("[]")
  createdAt   DateTime       @default(now())

  grades      Grade[]

  @@index([subjectId])
}

model Grade {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score        Float?     // escala NUMERIC
  optionCode   String?    // escala OPTIONS
  rubricScores Json?      // { [criterionId]: puntos }
  comment      String     @default("")
  gradedAt     DateTime   @default(now())

  @@unique([assignmentId, studentId])
}

// Rúbrica guardada por el maestro para reutilizar en otras asignaciones
model RubricTemplate {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name      String
  criteria  Json     // [{ title, description, points }]
  createdAt DateTime @default(now())

  @@index([teacherId])
}
